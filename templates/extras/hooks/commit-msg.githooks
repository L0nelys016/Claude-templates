#!/bin/sh
# Conventional Commits, title only, no co-author / Claude mention.
msg_file="$1"
lines=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d')
title=$(printf '%s\n' "$lines" | head -n 1)

case "$title" in Merge\ *|Revert\ *) exit 0 ;; esac

if ! printf '%s' "$title" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._-]+\))?!?: .+'; then
  echo "commit-msg: title must be '<type>: <text>' (feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)" >&2
  exit 1
fi
if [ "$(printf '%s\n' "$lines" | wc -l)" -gt 1 ]; then
  echo "commit-msg: commit must have a title only (no body, no trailers)" >&2
  exit 1
fi
if printf '%s' "$lines" | grep -Eiq 'co-authored-by|claude'; then
  echo "commit-msg: no co-author / Claude mention allowed" >&2
  exit 1
fi
